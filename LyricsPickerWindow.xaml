<Window x:Class="FluentLyrics.LyricsPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择歌词"
        Width="460" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="380" MinHeight="300"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"
        Background="#F3F3F3">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StatusText"
                   Text="自动匹配的歌词版本可能不对，选一个试试："
                   FontSize="13" Foreground="#D0000000" TextWrapping="Wrap" />

        <ListBox Grid.Row="1" x:Name="CandidateList"
                 Margin="0,10,0,10"
                 FontSize="13"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,5">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="11"
                                   Foreground="#8C000000"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ApplyButton" Content="应用" Width="80" Height="30" Click="Apply_Click" />
            <Button Content="取消" Width="80" Height="30" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
