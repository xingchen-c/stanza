<Window x:Class="FluentLyrics.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluentLyrics 设置"
        Width="440" Height="660"
        MinWidth="400" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="#202020"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI">
    <!-- WindowChrome 路线：DWM 负责圆角与投影（Win11），比 AllowsTransparency 清晰且硬件合成 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      CornerRadius="8"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False"
                      ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- WinUI 3 深色 token（FluentFlyout 风格） -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
        <SolidColorBrush x:Key="CardFillBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#19000000" />
        <SolidColorBrush x:Key="DividerBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#E64CC2FF" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#CC4CC2FF" />
        <SolidColorBrush x:Key="ControlFillBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#15FFFFFF" />
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#08FFFFFF" />
        <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#8BFFFFFF" />
        <SolidColorBrush x:Key="ToggleOffKnobBrush" Color="#C5FFFFFF" />
        <SolidColorBrush x:Key="ToggleOnKnobBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#2C2C2C" />
        <SolidColorBrush x:Key="ButtonTextOnAccentBrush" Color="#1B1B1B" />

        <!-- 分组标题（卡片外，左对齐） -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 分组卡片：白 70% + 1px 浅描边 + 圆角 8，无投影 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 开关行：左侧标签/描述，右侧 ToggleSwitch -->
        <Style x:Key="SwitchRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="16,0" />
        </Style>

        <!-- 行分隔线 -->
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource DividerBrush}" />
            <Setter Property="Margin" Value="16,0" />
        </Style>

        <!-- ToggleSwitch：Win11 风格开关（ToggleButton 重模板） -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource ToggleOffBorderBrush}"
                                    BorderThickness="1" />
                            <Ellipse x:Name="Knob" Width="12" Height="12"
                                     Fill="{StaticResource ToggleOffKnobBrush}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslate" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource ToggleOnKnobBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="16" />
                                <Setter TargetName="Knob" Property="Height" Value="16" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider：2px 轨道，accent 实心圆形 Thumb -->
        <Style x:Key="FluentSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="2" CornerRadius="1" Background="{StaticResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="2" CornerRadius="1" Background="#2B000000" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbEllipse" Fill="{StaticResource AccentBrush}" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbEllipse" Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
                                                        <Setter TargetName="ThumbEllipse" Property="StrokeThickness" Value="2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（accent 三态，Hover 换底色而非降透明度） -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource ButtonTextOnAccentBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮 -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏关闭按钮 -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox：32 高圆角，弹出层圆角 + 选中竖条 -->
        <Style x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{StaticResource ControlFillBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                            <ToggleButton x:Name="toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Margin="12,0,30,0" IsHitTestVisible="False">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="&#xE70D;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   StaysOpen="False">
                                <Border Background="{StaticResource PopupBackgroundBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Hidden">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem：悬停底 + 选中项左侧 accent 竖条 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="indicator" Width="2.5" Height="16" CornerRadius="1.25"
                                    Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left" Margin="6,0,0,0"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="18,0,10,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="FluentLyrics 设置"
                           FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="&#xE711;"
                    Style="{StaticResource CloseButton}"
                    Click="Close_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    HorizontalAlignment="Right" />
        </Grid>

        <!-- 内容 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 页头：大标题 + 版本号 -->
            <Grid Grid.Row="0" Margin="20,10,20,8">
                <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="VersionText" Text="v0.2.0"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="16,0,16,0">
            <StackPanel>
                <!-- 歌词 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="歌词" Style="{StaticResource GroupHeader}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid MinHeight="54" Margin="16,8,16,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="字号" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="歌词文字大小" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="FontSizeValue" Text="15 px"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="FontSizeSlider"
                                    Minimum="10" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True" Value="15"
                                    Style="{StaticResource FluentSlider}" Margin="0,6,0,0" />
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid MinHeight="54" Margin="16,8,16,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="歌词颜色" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="亮色层与状态文本颜色" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Row="1" x:Name="ColorCombo" Style="{StaticResource FluentComboBox}" Margin="0,6,0,0">
                                <ComboBoxItem Content="白色" Tag="#FFFFFFFF" IsSelected="True" />
                                <ComboBoxItem Content="亮黄" Tag="#FFFFE08A" />
                                <ComboBoxItem Content="青色" Tag="#FF8AE8FF" />
                                <ComboBoxItem Content="浅绿" Tag="#FFA8FFB0" />
                                <ComboBoxItem Content="粉红" Tag="#FFFFA8D8" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid MinHeight="54" Margin="16,8,16,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="歌词偏移" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="正数 = 歌词提前显示" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="OffsetValue" Text="0 ms"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="OffsetSlider"
                                    Minimum="-2000" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" Value="0"
                                    Style="{StaticResource FluentSlider}" Margin="0,6,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 任务栏 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE738;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="任务栏" Style="{StaticResource GroupHeader}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource SwitchRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="贴 FluentFlyout 组件" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="有组件时紧贴其右侧" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="FluentFlyoutCheck"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource SwitchRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="独立定位" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="不依赖外部组件" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="IndependentCheck"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid MinHeight="54" Margin="16,8,16,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="放置方向" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="相对锚点组件的左右位置" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Row="1" x:Name="DirectionCombo" Style="{StaticResource FluentComboBox}" Margin="0,6,0,0">
                                <ComboBoxItem Content="自动（左半区贴右、右半区贴左）" Tag="Auto" IsSelected="True" />
                                <ComboBoxItem Content="始终贴组件右侧" Tag="Right" />
                                <ComboBoxItem Content="始终贴组件左侧" Tag="Left" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource SwitchRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="歌词栏宽度" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="自动适配跟随定位区域" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="AutoWidthCheck"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="AutoWidth_Changed" Unchecked="AutoWidth_Changed" />
                        </Grid>

                        <Grid Margin="16,0,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="WidthSlider" Minimum="120" Maximum="1200"
                                    TickFrequency="10" IsSnapToTickEnabled="True" Value="600"
                                    Style="{StaticResource FluentSlider}" IsEnabled="False" />
                            <TextBlock Grid.Column="1" x:Name="WidthValue" Text="600 px"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 媒体控制 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="媒体控制" Style="{StaticResource GroupHeader}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource SwitchRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="显示封面与播放控制" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="悬停卡片时呼出" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="MediaControlsCheck"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource SwitchRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="暂停时隐藏歌词卡片" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="关闭后暂停也保持显示" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="HideOnPauseCheck"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 通用 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="通用" Style="{StaticResource GroupHeader}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource SwitchRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="鼠标点击穿透" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="歌词区点击不干扰任务栏" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="ClickThroughCheck"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource SwitchRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="开机自启" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="登录 Windows 后自动运行" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="AutoStartCheck"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        </Grid>

        <!-- 页脚：保存/取消 -->
        <Grid Grid.Row="2">
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,0,16,0" VerticalAlignment="Center">
                <Button Content="保存" Style="{StaticResource AccentButton}" Click="Save_Click" />
                <Button Content="取消" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
