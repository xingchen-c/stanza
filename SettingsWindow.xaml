<Window x:Class="FluentLyrics.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluentLyrics 设置"
        Width="380" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <StackPanel Margin="20">
        <TextBlock Text="歌词字号" Margin="0,0,0,4" />
        <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="28"
                TickFrequency="1" IsSnapToTickEnabled="True" Value="15" />

        <TextBlock Text="歌词颜色" Margin="0,12,0,4" />
        <ComboBox x:Name="ColorCombo">
            <ComboBoxItem Content="白色" Tag="#FFFFFFFF" IsSelected="True" />
            <ComboBoxItem Content="亮黄" Tag="#FFFFE08A" />
            <ComboBoxItem Content="青色" Tag="#FF8AE8FF" />
            <ComboBoxItem Content="浅绿" Tag="#FFA8FFB0" />
            <ComboBoxItem Content="粉红" Tag="#FFFFA8D8" />
        </ComboBox>

        <TextBlock Text="滚动速度（数字越大越快）" Margin="0,12,0,4" />
        <Slider x:Name="SpeedSlider" Minimum="20" Maximum="150"
                TickFrequency="1" IsSnapToTickEnabled="True" Value="55" />

        <TextBlock Text="歌词偏移（毫秒，正数 = 歌词提前显示）" Margin="0,12,0,4" />
        <Slider x:Name="OffsetSlider" Minimum="-2000" Maximum="2000"
                TickFrequency="50" IsSnapToTickEnabled="True" Value="0" />

        <CheckBox x:Name="ClickThroughCheck" Content="鼠标点击穿透" Margin="0,14,0,0" />
        <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,8,0,0" />

        <TextBlock Text="任务栏定位（白名单）" Margin="0,14,0,4" />
        <CheckBox x:Name="FluentFlyoutCheck" Content="贴 FluentFlyout 组件" Margin="0,0,0,6" />
        <CheckBox x:Name="IndependentCheck" Content="独立定位（不依赖外部组件）" Margin="0,0,0,8" />

        <TextBlock Text="放置方向（相对锚点组件）" Margin="0,4,0,4" />
        <ComboBox x:Name="DirectionCombo">
            <ComboBoxItem Content="自动（左半区贴右、右半区贴左）" Tag="Auto" IsSelected="True" />
            <ComboBoxItem Content="始终贴组件右侧" Tag="Right" />
            <ComboBoxItem Content="始终贴组件左侧" Tag="Left" />
        </ComboBox>

        <TextBlock Text="歌词栏宽度" Margin="0,14,0,4" />
        <CheckBox x:Name="AutoWidthCheck" Content="自动适配（跟随定位区域）"
                  Checked="AutoWidth_Changed" Unchecked="AutoWidth_Changed" />
        <Slider x:Name="WidthSlider" Minimum="120" Maximum="1200"
                TickFrequency="10" IsSnapToTickEnabled="True" Value="600"
                IsEnabled="False" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="保存" Width="80" Click="Save_Click" />
            <Button Content="取消" Width="80" Margin="10,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
