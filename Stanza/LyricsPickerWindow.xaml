<Window x:Class="Stanza.LyricsPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择歌词"
        Width="460" Height="590"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="CanResize"
        MinWidth="440" MinHeight="450"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"
        Background="#F3F3F3">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TrackText" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusText" Text="正在搜索歌词版本…" Margin="0,6,0,0"
                       FontSize="13" Foreground="#D0000000" TextWrapping="Wrap" />
            <ProgressBar x:Name="LoadingProgress" Height="3" Margin="0,8,0,0"
                         IsIndeterminate="True" />
            <DockPanel Margin="0,10,0,0">
                <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="重新搜索"
                        Padding="8,3" Click="Retry_Click" IsEnabled="False" />
                <CheckBox x:Name="ShowOtherArtistsCheckBox" Content="显示其他歌手的同名版本"
                          VerticalAlignment="Center" IsEnabled="False"
                          Checked="ShowOtherArtists_Changed" Unchecked="ShowOtherArtists_Changed" />
            </DockPanel>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="CandidateList"
                 Margin="0,10,0,10"
                 FontSize="13"
                 SelectionMode="Single" IsEnabled="False"
                 SelectionChanged="CandidateList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,5" ToolTip="{Binding Detail}">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="11"
                                   Foreground="#8C000000"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="本曲歌词偏移" VerticalAlignment="Center" />
                <TextBlock Text="即时保存，与全局偏移叠加" FontSize="11" Foreground="#8C000000"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <RepeatButton x:Name="DelayButton" Grid.Column="0" Content="延后 100 ms" Height="28"
                              Click="Delay_Click" />
                <TextBlock x:Name="OffsetText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <RepeatButton x:Name="AdvanceButton" Grid.Column="2" Content="提前 100 ms" Height="28"
                              Click="Advance_Click" />
                <Button x:Name="ResetOffsetButton" Grid.Column="3" Content="归零" Height="28" Margin="8,0,0,0"
                        Click="ResetOffset_Click" />
            </Grid>
            <TextBlock x:Name="OffsetStatusText" FontSize="11" Foreground="#B0000000" Margin="0,4,0,0"
                       TextWrapping="Wrap" />
            <Button x:Name="RestoreAutomaticButton" Content="恢复本曲自动匹配" HorizontalAlignment="Left"
                    Padding="8,4" Margin="0,8,0,0" Click="RestoreAutomatic_Click"
                    ToolTip="清除本曲手选记忆并重新匹配，保留本曲偏移" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ApplyButton" Content="应用" Width="80" Height="30" IsEnabled="False" Click="Apply_Click" />
            <Button Content="关闭" Width="80" Height="30" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
