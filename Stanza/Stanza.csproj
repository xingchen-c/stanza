<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <Version>0.3.1</Version>
        <!-- 桌面小工具用 Workstation GC：22 核机器上 Server GC 会预分配大量堆内存（实测 800MB+），
             工作站 GC 完全够用且内存占用低一个量级 -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Lyricify.Lyrics.Helper" Version="0.2.0"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12"/>
        <PackageReference Include="Serilog" Version="4.*"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.*"/>
        <PackageReference Include="Serilog.Sinks.Async" Version="2.*"/>
        <Resource Include="Assets\app.ico"/>

        <!-- WinForms 只用于托盘；去掉它带来的隐式 using，避免与 WPF 的 Application/Point 等撞名 -->
        <Using Remove="System.Drawing"/>
        <Using Remove="System.Windows.Forms"/>
    </ItemGroup>

    <!-- 单元测试项目可见内部成员（纯函数测试用） -->
    <ItemGroup>
        <InternalsVisibleTo Include="Stanza.Tests"/>
    </ItemGroup>

</Project>
